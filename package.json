{
  "name": "bun-chrome-extension",
  "version": "0.0.1",
  "description": "A Chrome extension built with Bun and React.",
  "module": "index.ts",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run config/watch.ts --dir=src,public",
    "build": "bun run config/build.ts",
    "pack": "bun run config/pack.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.0",
    "date-fns": "^4.1.0",
    "element-ready": "^7.0.0",
    "lodash.get": "^4.4.2",
    "lucide-react": "^0.483.0",
    "octokit": "^4.1.2",
    "parse-md": "^3.0.3",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-aria-components": "^1.7.1",
    "react-day-picker": "8.10.1",
    "react-dom": "^18.3.1",
    "react-gantt-chart": "workspace:*",
    "react-hook-form": "^7.55.0",
    "sonner": "^2.0.2",
    "tailwind-merge": "^3.0.2",
    "vaul": "^1.1.2",
    "zod": "^3.24.2",
    "zustand": "^5.0.3",
    "zustand-chrome-storage": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@eslint/js": "^9.23.0",
    "@tailwindcss/cli": "^4.0.15",
    "@tailwindcss/postcss": "^4.0.15",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/adm-zip": "^0.5.5",
    "@types/bun": "latest",
    "@types/chrome": "^0.0.270",
    "@types/lodash.get": "^4.4.9",
    "@types/react-dom": "^18.3.0",
    "adm-zip": "^0.5.15",
    "autoprefixer": "^10.4.21",
    "chalk": "^5.3.0",
    "eslint": "^9.23.0",
    "husky": "^9.1.7",
    "lefthook": "^1.7.14",
    "lint-staged": "^15.5.0",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.15",
    "tw-animate-css": "^1.2.4",
    "typescript": "^5",
    "typescript-eslint": "^8.28.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  }
}
