{
  "name": "Github Gantt Chart Support",
  "description": "Github Gantt Chart Support",
  "short_name": "Github Gantt Chart",

  "version": "0.1.2",
  "manifest_version": 3,
  "icons": {
    "36": "icons/36.png",
    "48": "icons/48.png",
    "72": "icons/72.png",
    "96": "icons/96.png"
  },
  "content_scripts": [
    {
      "matches": ["*://github.com/*"],
      "css": ["main.css"],
      "js": ["index.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["scripting", "storage"],
  "host_permissions": ["*://github.com/*"]
}
