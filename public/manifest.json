{
  "name": "Github Gantt Chart Support BETA",
  "description": "Github Gantt Chart Support. THIS EXTENSION IS FOR BETA TESTING",
  "short_name": "Github Gantt Chart",

  "version": "0.2.5",
  "manifest_version": 3,
  "icons": {
    "36": "icons/36.png",
    "48": "icons/48.png",
    "72": "icons/72.png",
    "96": "icons/96.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://github.com/*"],
      "css": ["main.css"],
      "js": ["index.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": ["scripting", "storage", "webRequest", "tabs", "activeTab"],
  "host_permissions": ["*://github.com/*"]
}
