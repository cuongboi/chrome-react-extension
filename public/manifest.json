{
  "name": "Github Agile Support",
  "description": "Github Agile Support",
  "short_name": "Github Agile",

  "version": "0.1.0",
  "manifest_version": 3,
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Extension action title",
    "default_popup": "popup/index.html"
  },
  "options_page": "options/index.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://github.com/*"],
      "js": ["content-script/index.js"],
      "css": ["main.css"],
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage", "notifications", "scripting", "activeTab", "tabs"],
  "host_permissions": ["*://github.com/*", "*://*.github.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["main.css"],
      "matches": ["https://*/*"]
    }
  ]
}
